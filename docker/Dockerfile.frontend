# DCN - Data Center Network Management Platform - Frontend
# Multi-stage build: Vite + Nginx
# Build: docker build -f docker/Dockerfile.frontend -t dcn-frontend:latest .

# ============================================================
# Stage 1: Builder — compile Vue/TypeScript with Vite
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Enable npm cache for faster installs
ENV npm_config_cache=/app/.npm-cache

# Copy package files first for better layer caching
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies (no BuildKit cache mount — 它会让 vite 的转换缓存跨构建存活,
# 导致改了 .vue 源码但产物 hash 不变)
RUN npm ci --no-audit --no-fund

# Copy source code
COPY frontend/ ./

# Vite 在构建期就把 import.meta.env.VITE_* 内联进产物，所以后端 WebSocket 端口
# 必须以 build arg 传进来。缺了它前端只能退回代码里的 '8002' 兜底，一旦改了
# BACKEND_PORT，Guacamole/RDP 的 WebSocket 就会连错端口。
ARG VITE_WS_PORT=8002
ENV VITE_WS_PORT=$VITE_WS_PORT

# Build for production (vue-tsc type check + vite build)
RUN npm run build

# ============================================================
# Stage 2: Production — Nginx serving static SPA
# ============================================================
# nginx:1.25-alpine 是最后一个在 CentOS 7 (内核 3.10) 上能正常启动的版本;
# 1.26+ 用了 pwritev2 等新系统调用,老内核会直接 EPERM。
FROM nginx:1.25-alpine

# Labels
LABEL maintainer="DCN Team" \
      org.opencontainers.image.title="DCN Frontend" \
      org.opencontainers.image.description="Data Center Network Management Platform - Web UI" \
      org.opencontainers.image.licenses="MIT"

# 以 root 运行 nginx:老内核对非 root 的 pwritev2 支持有问题,
# 且这是纯静态文件服务,无安全边界需求。
USER root

# Copy nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/security-headers.conf /etc/nginx/security-headers.conf

# Copy built static files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
