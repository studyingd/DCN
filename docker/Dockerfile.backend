# DCN - Data Center Network Management Platform - Backend
# Multi-stage build optimized for production
# Build: docker build -f docker/Dockerfile.backend -t dcn-backend:latest .

# ============================================================
# Stage 1: Builder — install Python dependencies
# ============================================================
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies for native packages (bcrypt, cryptography)
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better layer caching
COPY backend/requirements.txt .

# Install into a temporary venv — we'll copy only site-packages later
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ============================================================
# Stage 2: Production
# ============================================================
FROM python:3.12-slim-bookworm

# Labels
LABEL maintainer="DCN Team" \
      org.opencontainers.image.title="DCN Backend" \
      org.opencontainers.image.description="Data Center Network Management Platform - Backend API Server" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install runtime helper.
# fonts-wqy-microhei: 巡检报告 PDF 需要内嵌中文字体。基础镜像不带任何 CJK 字体，
# 缺字体时报告会退回 reportlab 内置的 STSong-Light——那是不内嵌的 Adobe CID 字体，
# 飞书桌面端预览用的 pdfium 不带 CJK 字体包，有渲染成空白方块的风险。
# 注意不要换成 fonts-noto-cjk：NotoSansCJK-*.ttc 是 PostScript/CFF 轮廓，
# reportlab 的 TTFont 只认 TrueType(glyf)，注册时直接报错（已在 bookworm 镜像实测）。
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    gosu \
    fonts-wqy-microhei \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder stage
COPY --from=builder /install /usr/local

# Copy application code
COPY backend/ ./

# Create non-root user
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --ingroup appgroup appuser && \
    chown -R appuser:appgroup /app

# Copy entrypoint script
COPY docker/docker-entrypoint-backend.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8002

# Health check — uses FastAPI's built-in /api/health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/api/health')" || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
