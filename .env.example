# ============================================================================
# DCN 数据中心网络管理平台 — 环境变量配置模板
# ============================================================================
# 使用前请复制为 .env 并修改所有占位符参数。
# .env 文件已加入 .gitignore，不会被提交到版本控制。
#
# Docker Compose 部署：
#   本文件同时作为 docker/docker-compose.yml 的变量源。
#   docker-compose 需要的变量用 ${VAR:?error} 标记（必须设置）
#   或用 ${VAR:-default} 标记（可选，有默认值）。
# ============================================================================

# ── MySQL 数据库（Docker Compose）─────────────────────────────────────────
# 以下变量供 docker/docker-compose.yml 中 mysql 服务使用。
# 后端 DATABASE_URL 使用 MYSQL_USER / MYSQL_PASSWORD 连接应用库，
# MYSQL_ROOT_PASSWORD 仅用于 MySQL 管理员初始化。
# MYSQL_PORT 为宿主机映射端口（默认 3306；本机 3306 被占用时可改为 3307 等）。
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
MYSQL_USER=dcn_app
MYSQL_PASSWORD=change-me-to-a-different-strong-password
MYSQL_DATABASE=dcn
MYSQL_PORT=3306
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_LONG_QUERY_TIME=1
# 落盘策略:默认 2/100(每秒刷 redo log / 每 100 次提交同步 binlog)。
# 监控类写入密集且样本数据可重建,性能优先;要求严格持久性改回 1/1。
MYSQL_FLUSH_LOG_AT_TRX_COMMIT=2
MYSQL_SYNC_BINLOG=100

# ── 数据库连接 ────────────────────────────────────────────────────────────
# Docker 部署:host 用服务名 "mysql"(docker/docker-compose.yml 已预置此值,无需改动)。
# 本地开发(uvicorn 直连):把 host 改为 127.0.0.1,端口与 MYSQL_PORT 一致。
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}?charset=utf8mb4
# 本地开发示例(取消注释并注释掉上面那行):
# DATABASE_URL=mysql+pymysql://root:change-me-to-a-strong-password@127.0.0.1:3306/dcn?charset=utf8mb4
# 启动时自动建表(仅本地开发便利)。生产必须为 false,改用 alembic upgrade head,
# 否则模型改动不会生成迁移,线上表结构会与代码悄悄不一致。
DCN_AUTO_CREATE=false

# ── JWT 认证 ──────────────────────────────────────────────────────────────
# 生产环境必须修改为强随机字符串！（可用 openssl rand -hex 32 生成）
# 不要与开发环境共用同一个值——共用意味着两个环境的登录 token 互相通用。
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
# Local quick-start uses plain HTTP. Set true when the frontend is served over HTTPS.
# 纯 HTTP 访问(如局域网 http://IP:8080)必须保持 false——浏览器会拒收纯 HTTP 下
# 的 Secure Cookie,表现为「登录成功却一直未登录」。
COOKIE_SECURE=false
JWT_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 管理员默认账户 ────────────────────────────────────────────────────────
# 首次启动时会用此账户创建管理员，生产环境务必修改密码！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── 应用日志 ──────────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR / CRITICAL，非法值回落 INFO。
# 排障时临时调成 DEBUG 可看到 SSH/PVE/Webhook 的详细往返；生产建议 INFO。
# 每行日志会自动带上请求的 traceId（与 X-Trace-Id 响应头一致），便于串联一次请求。
LOG_LEVEL=INFO

# ── Guacamole guacd (RDP 代理) ────────────────────────────────────────────
# Docker 部署:host 用服务名 "guacd"(docker/docker-compose.yml 已预置,无需改动)。
# 本地开发:改为 127.0.0.1,并自行在本地起一个 guacd 容器(端口 4822)。
GUACD_HOST=guacd
GUACD_PORT=4822
# guacd 能直接访问目标网段时保持 false，可减少一层 TCP 转发延迟。
GUACD_USE_RELAY=false
# RDP 安全策略:negotiate/tls/nls/any。默认 any(兼容老服务器)，生产建议收紧为 tls 或 nls。
GUAC_RDP_SECURITY=any
# RDP 证书校验:false=校验(默认)。仅在受控内网且目标确实用自签证书时设 true 跳过。
GUAC_RDP_IGNORE_CERT=false
# RDP 色深:8/16/24/32。8 位带宽最省，但若浏览器出现「画面冻结卡死」则改为 16/24/32。
GUAC_RDP_COLOR_DEPTH=8

# ── 凭证加密密钥 ──────────────────────────────────────────────────────────
# 生产环境必须修改！此密钥用于加密存储的 SSH/RDP 凭证。
# 生成方式: openssl rand -hex 32
# 迁移注意:从旧环境导入数据库必须沿用旧环境的 CREDENTIAL_SECRET_KEY,
# 换新密钥会导致库里已保存的设备凭据全部无法解密。
CREDENTIAL_SECRET_KEY=change-me-to-a-random-string

# ── 设备监控 ──────────────────────────────────────────────────────────────
MONITOR_INTERVAL=30
MONITOR_TIMEOUT=2
MONITOR_CONCURRENCY=20

# ── WinRM(Windows 设备管理通道;平台不对 Windows 使用 SSH)─────────────────
# NTLM 认证;5985(HTTP)有消息级加密。SSL 证书默认校验,受控内网自签可关。
WINRM_ENABLED=true
WINRM_PORT=5985
WINRM_USE_SSL=false
WINRM_CERT_VALIDATION=true

# ── 服务器指标采集(CPU/内存/磁盘/负载/网络;Linux 走 SSH,Windows 走 WinRM)──
METRICS_ENABLED=true
METRICS_INTERVAL=60
METRICS_CONCURRENCY=10
METRICS_TIMEOUT=15
METRICS_RETENTION_DAYS=7

# ── PVE 虚拟机状态快照(业务监控展示虚机运行状态)──────────────────────────
# 后台循环拉取 /cluster/resources 缓存到内存，业务接口只读快照;
# PVE 不可达时保留上次数据并把虚机标记为"状态未知"，不计入业务健康。
PVE_STATUS_ENABLED=true
PVE_STATUS_INTERVAL=30
PVE_STATUS_TIMEOUT=6
# 虚拟机磁盘使用率采集(磁盘告警数据源):QGA get-fsinfo 优先,运维接入
# SSH/WinRM 兑底;只在存在启用中的 disk_max_pct 规则时才采集。每轮对每台
# 目标虚机真实调 PVE API/QGA 或握手 SSH,故用独立低频循环(评估只读缓存)。
GUEST_FS_METRICS_ENABLED=true
GUEST_FS_METRICS_INTERVAL=300

# ── Agent 诊断(LLM 只读排障,OpenAI 兼容接口;默认关闭)────────────────────
# 边界:LLM 只能执行预置只读诊断项,永远无法接触 shell 自由输入;全量落审计。
# AGENT_ENABLED=true
# AGENT_LLM_BASE_URL=http://your-llm-gateway/v1
# AGENT_LLM_API_KEY=your-key
# AGENT_LLM_MODEL=your-model
# 单次 LLM 请求超时(秒)。告警归因会串起多步调用，这个值直接决定一次归因的总耗时上限。
# AGENT_LLM_TIMEOUT=60
# AGENT_MAX_STEPS=8
# 单条只读诊断命令的执行超时(秒)
# AGENT_CMD_TIMEOUT=20
# 单条诊断命令回传给 LLM 的最大字符数，超出截断(防止一次 df/top 输出撑爆上下文)
# AGENT_MAX_OUTPUT_CHARS=6000
# 同时执行的 Agent 诊断运行数上限(每次运行占一条 SSH/WinRM 连接 + 一个 LLM
# 会话;批量诊断/归因集中触发时按信号量排队)。
# AGENT_MAX_CONCURRENT_RUNS=4
# LLM 瞬时错误(429/5xx/连接抖动)的最大重试次数,指数退避后重试;4xx 不重试。
# AGENT_LLM_MAX_RETRIES=2

# ── 业务监控:接口 HTTP 探测(后端直接探测,周期 upsert interface_probes)─────
INTERFACE_PROBE_ENABLED=true
INTERFACE_PROBE_INTERVAL=60
INTERFACE_PROBE_CONCURRENCY=10

# ── Docker 容器管理(周期探测服务器内所有容器;Linux 走 SSH,Windows 走 WinRM)─
CONTAINERS_ENABLED=true
CONTAINERS_INTERVAL=60
CONTAINERS_CONCURRENCY=10
# 单台设备容器列表拉取超时(秒)。容器多的宿主机 docker ps 会慢，超时后该设备本轮跳过。
CONTAINERS_TIMEOUT=25

# ── 告警自愈(离线自动拉起 + 指标过高 AI 归因;默认开启)─────────────────────
# host_status / container_status 告警触发后自动尝试启动目标:PVE 虚拟机下发 start,
# 容器走 docker start 并写操作审计;物理机无法远程上电时标记 skipped。处置进度会以
# 话术形式实时拼进告警消息,随 Webhook 一起推送。
ALERT_AUTO_REMEDIATION=true
ALERT_AUTO_ANALYSIS=true
# 同一事件最多自动拉起次数,达到上限后需在告警中心人工触发
ALERT_REMEDIATION_MAX_ATTEMPTS=2
# 两次自动拉起之间的最小间隔(秒),避免把反复启动做成 boot loop
ALERT_REMEDIATION_COOLDOWN_SECONDS=600
# 下发启动指令后等待目标恢复运行的最长时间(秒)
ALERT_REMEDIATION_VERIFY_SECONDS=90
# cpu/mem/disk 持续超阈值多久后才调用 Agent 归因(秒),过滤瞬时毛刺。
# 仅在"不扣住通知"时生效:开启 HOLD_NOTIFICATION 后,告警既然要等结论一起发,
# 就会立刻归因(防抖由规则自己的 sustain_seconds 负责)。
ALERT_ANALYSIS_SUSTAIN_SECONDS=180
# 等待 Agent 诊断报告的最长时间(秒),超时按分析失败处理
ALERT_ANALYSIS_WAIT_SECONDS=300
# 指标告警(CPU/内存/磁盘)是否先扣住 alert.created,等 AI 归因结论出来后连同结论
# 一起发。true=一条消息里就带归因结果(飞书卡片的「AI 归因」块直接有内容);
# false=告警立刻发,归因结论另发一条 alert.remediation。
ALERT_ANALYSIS_HOLD_NOTIFICATION=true
# 扣住通知的上限(秒)。归因卡死/进程重启时由看门狗放行,告警可以迟到但不会被吞。
# 要大于一次正常归因的耗时(实测约 50s)。
ALERT_ANALYSIS_HOLD_TIMEOUT_SECONDS=180
# 告警归因单-pass 结论轮的 LLM 超时(秒)。结论仅 ~200 字,不需要报告轮的 180s;
# 取证 + 失败重试一轮的总耗时要能落在 HOLD_TIMEOUT 内,卡片才稳定单条带结论。
# 提示:docker 部署下 .env 不透传该变量(compose 未列),代码默认值即容器值。
ALERT_ANALYSIS_LLM_TIMEOUT=60

# ── 通知文案时区 ──────────────────────────────────────────────────────────
# 数据库统一存 UTC;飞书卡片、多维表格 alert_time 等给人读的时间按此时区(IANA
# 名称)渲染。留空则跟随服务器系统时区——Docker 容器默认是 UTC，通常不是想要的。
DISPLAY_TIMEZONE=Asia/Shanghai

# ── 速率限制 ──────────────────────────────────────────────────────────────
# RATE_LIMIT_STORAGE / WS_TICKET_STORAGE 决定限流计数与终端票据存哪:
#   - 单进程部署(本地开发 / 单容器):写 memory://,无需 Redis
#   - 多副本/多 worker 部署:必须指向共享 Redis,否则限流失效、票据跨进程丢失、
#     后台采集任务重复执行(见 backend/app/services/background_leader.py)
# Docker Compose 部署时 docker/docker-compose.yml 已默认指向 redis://redis:6379/0,无需改动;
# 本地开发请改成 memory://。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis://redis:6379/0
WS_TICKET_STORAGE=redis://redis:6379/0
# uvicorn 的反向代理信任名单:仅 Docker 部署需要(nginx 从 compose 内网连到 backend)。
# 本地开发(uvicorn 直连)可保持默认或注释掉——此时没有反向代理,XFF 不会被采信。
FORWARDED_ALLOW_IPS=172.28.0.0/16,127.0.0.1
# 多副本/多 worker 时仅允许一个实例运行采集与调度任务。
BACKGROUND_TASKS_ENABLED=true

# ── CORS ─────────────────────────────────────────────────────────────────
# 列出所有允许跨域访问后端的前端源。Docker 部署含 FRONTEND_PORT(默认 8080);
# 本地开发含 Vite dev server(默认 5040)。按需删减,不要写 *(凭证模式下不允许)。
# 生产要补上实际访问源(如 http://<服务器IP或域名>:8080)——同源部署不触发
# CORS,但换域名/IP 访问或直连后端调试时会用到。
CORS_ORIGINS=http://localhost:5040,http://127.0.0.1:5040,http://localhost:8080,http://localhost:5173,http://localhost:3000

# ── 服务端口 ──────────────────────────────────────────────────────────────
# 仅 Docker Compose 使用
FRONTEND_PORT=8080
BACKEND_PORT=8002
# RDP(Guacamole)的 WebSocket **直连**这个端口(子协议协商原因,不走同源):
#   - 推荐 = FRONTEND_PORT:浏览器 WS 走 nginx /ws 反代到 backend,backend 保持
#     仅回环监听。RDP 走 nginx 已实测完整可用(guacamole 子协议会被透传,
#     客户端不要求回显);SSH 终端本就走同源,不受此值影响。
#   - 仅当 backend 端口对外发布(0.0.0.0),或浏览器与服务器同机(localhost
#     访问)时,才用 BACKEND_PORT(8002) 直连。
# 注意这是**构建期**变量:Vite 把它内联进静态产物,改完必须重建前端镜像
# (docker compose build frontend)才生效,光重启容器没用。改 FRONTEND_PORT
# 时记得同步改这里;前端挂在外部 LB/网关后则设为对外的公网端口。
VITE_WS_PORT=8080
# ── Compose 项目名(决定容器/卷命名前缀)─────────────────────────────
# 不设置时项目名 = compose 文件所在目录名(如 docker/ → "docker",卷叫
# docker_mysql-data)。固定为 dcn 后容器/卷命名稳定,不受部署路径影响。
# 注意:已在运行的机器上后改此值会创建一套新的空卷(旧数据仍在旧卷里),
# 迁移需显式搬 volume,不要在现有环境随手改。
COMPOSE_PROJECT_NAME=dcn
# compose 内部网段。固定下来 FORWARDED_ALLOW_IPS 才有稳定值可信任,否则每次重建
# 网络都可能换网段。与宿主机已有 Docker 网络冲突时改这里(需 docker compose down
# 重建网络后再 up)。
DCN_NETWORK_SUBNET=172.28.0.0/16
