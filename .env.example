# ============================================================================
# DCN 数据中心网络管理平台 — 环境变量配置模板
# ============================================================================
# 使用前请复制为 .env 并修改所有占位符参数。
# .env 文件已加入 .gitignore，不会被提交到版本控制。
#
# Docker Compose 部署：
#   本文件同时作为 docker-compose.yml 的变量源。
#   docker-compose 需要的变量用 ${VAR:?error} 标记（必须设置）
#   或用 ${VAR:-default} 标记（可选，有默认值）。
# ============================================================================

# ── MySQL 数据库（Docker Compose）─────────────────────────────────────────
# 以下变量供 docker-compose.yml 中 mysql 服务使用。
# MYSQL_ROOT_PASSWORD 也用于后端 DATABASE_URL。
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password
MYSQL_DATABASE=dcn

# ── 数据库连接 ────────────────────────────────────────────────────────────
# Docker 部署时 host 使用服务名 "mysql"
DATABASE_URL=mysql+pymysql://root:${MYSQL_ROOT_PASSWORD}@mysql:3306/${MYSQL_DATABASE}?charset=utf8mb4

# ── JWT 认证 ──────────────────────────────────────────────────────────────
# 生产环境必须修改为强随机字符串！（可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 管理员默认账户 ────────────────────────────────────────────────────────
# 首次启动时会用此账户创建管理员，生产环境务必修改密码！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Guacamole guacd (RDP 代理) ────────────────────────────────────────────
# Docker 部署时 host 使用服务名 "guacd"
GUACD_HOST=guacd
GUACD_PORT=4822

# ── 凭证加密密钥 ──────────────────────────────────────────────────────────
# 生产环境必须修改！此密钥用于加密存储的 SSH/RDP 凭证。
# 生成方式: openssl rand -hex 32
CREDENTIAL_SECRET_KEY=change-me-to-a-random-string

# ── MinIO / RustFS 对象存储 ──────────────────────────────────────────────
# Docker 部署时 endpoint 使用服务名 "rustfs:9000"
MINIO_ENDPOINT=rustfs:9000
MINIO_ACCESS_KEY=dcn-minio-access
MINIO_SECRET_KEY=dcn-minio-secret
MINIO_SECURE=false
MINIO_BUCKET_RECORDINGS=dcn-recordings
MINIO_BUCKET_AUDIT=dcn-audit-logs

# ── 设备监控 ──────────────────────────────────────────────────────────────
MONITOR_INTERVAL=30
MONITOR_TIMEOUT=2
MONITOR_CONCURRENCY=20

# ── 速率限制 ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://

# ── CORS ─────────────────────────────────────────────────────────────────
# Docker 部署时包含前端端口；本地开发时包含 Vite dev server 端口
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ── 服务端口 ──────────────────────────────────────────────────────────────
# 仅 Docker Compose 使用
FRONTEND_PORT=8080
BACKEND_PORT=8002
